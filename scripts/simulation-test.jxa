ObjC.import("Foundation");

// 无头模拟测试：真实发牌、真实 AI 决策，验证第二版的筹码深度策略。
// 与 smoke-test.jxa 的区别是它会打完整手牌，而不只是渲染检查。

function makeElement(id) {
  return {
    id: id, value: "", textContent: "",
    innerHTML: id === "gameLog" ? '<div class="empty-state"></div>' : "",
    hidden: false, disabled: false,
    dataset: {}, children: [],
    classList: { add: function () {}, remove: function () {}, toggle: function () {} },
    style: { width: "", setProperty: function (key, value) { this[key] = value; } },
    addEventListener: function (name, callback) { this["on" + name] = callback; },
    querySelector: function (selector) { return selector === ".empty-state" && this.innerHTML.indexOf("empty-state") >= 0 ? {} : null; },
    prepend: function (child) { this.children.unshift(child); this.innerHTML = "content"; },
    appendChild: function (child) { this.children.push(child); },
    get lastElementChild() { return this.children[this.children.length - 1]; },
    remove: function () {}
  };
}

var ids = [
  "setupModal", "startButton", "leaveButton", "aiCount", "startingChips", "blindLevel", "thinkSpeed",
  "gameMode", "blindField", "tournamentNote",
  "opponentList", "opponentCount", "seatLayer", "communityCards", "chipFxLayer", "potAmount", "handNumber", "blindInfo", "handsPlayed",
  "gameLog", "turnLabel", "handHint", "handInvestment", "betSlider", "betAmountLabel", "foldButton", "callButton", "raiseButton",
  "soundButton", "toast", "statsButton", "statsModal", "statsClose", "statHands", "statVpip", "statPfr",
  "statShowdown", "statNet", "statNetBar", "positionStats",
  "tournamentHud", "hudLevel", "hudNextLevel", "hudAverage", "hudPressure", "hudProgress",
  "betInput"
];
var elements = {};
ids.forEach(function (id) { elements[id] = makeElement(id); });

var allInButton = makeElement("allin"); allInButton.dataset = { allin: "1" };
var quickButtons = ["0.33", "0.5", "0.75", "1"].map(function (pot) {
  var el = makeElement("quick"); el.dataset.pot = pot; return el;
});

var document = {
  baseURI: "file:///android_asset/index.html",
  hidden: false,
  getElementById: function (id) { return elements[id]; },
  querySelectorAll: function () { return quickButtons; },
  querySelector: function (selector) { return selector === "[data-allin]" ? allInButton : null; },
  createElement: function (tag) { return makeElement(tag); },
  addEventListener: function () {}
};
var localStorage = { getItem: function () { return null; }, setItem: function () {} };
var crypto = { getRandomValues: function (array) { for (var i = 0; i < array.length; i++) array[i] = (Math.random() * 4294967296) >>> 0; return array; } };

var window = { __pokerTest: true };
var self = window;
function setTimeout() { return 1; }
function clearTimeout() {}

var basePath = "/Users/Apple/develop/poker/dist/";
// 按 index.html 中的顺序加载全部模块。
["poker-core.js", "poker-state.js", "poker-stats.js", "poker-ui.js", "poker-ai.js", "poker-table.js", "game.js"].forEach(function (file) {
  eval($.NSString.stringWithContentsOfFileEncodingError(basePath + file, $.NSUTF8StringEncoding, null).js);
});

function assert(condition, message) { if (!condition) throw new Error(message); }

assert(window.PokerTest, "测试钩子未启用");

// --- 场景一：标准码 100BB，深码标记应为真 ---
elements.aiCount.value = "3";
elements.startingChips.value = "5000";
elements.blindLevel.value = "25";
elements.thinkSpeed.value = "fast";
elements.startButton.onclick();

var T = window.PokerTest;
assert(T.game, "开桌后 game 状态应存在");
assert(T.game.players.length === 4, "应为 1 名玩家加 3 名 AI");

var hero = T.game.players[0];
hero.cards = [{ rank: 14, suit: "♠" }, { rank: 13, suit: "♠" }];
T.game.community = [{ rank: 2, suit: "♥" }, { rank: 7, suit: "♦" }, { rank: 9, suit: "♣" }];

var ctx = T.strategyContext(hero);
assert(ctx.effectiveBb > 0, "有效筹码深度应为正数");
assert(ctx.bucket === "standard" || ctx.bucket === "deep", "5000 筹码 25 大盲应为标准或深码，实际 " + ctx.bucket);
assert(ctx.opponents === 3, "应有 3 名对手，实际 " + ctx.opponents);
assert(ctx.multiway === true, "3 名对手应判定为多人底池");
assert(ctx.deep === true, "标准码应标记为 deep");
assert(ctx.pushFold === false, "标准码不应进入短码全下模式");

// --- 场景二：短码 10BB，应触发全下倾向 ---
var shortGame = window.PokerTest.game;
shortGame.players.forEach(function (p) { p.chips = 250; });
var shortCtx = T.strategyContext(hero);
assert(shortCtx.bucket === "critical", "250 筹码 25 大盲应为 critical，实际 " + shortCtx.bucket);
assert(shortCtx.pushFold === true, "短码应进入全下模式");
assert(shortCtx.deep === false, "短码不应标记为 deep");

// --- 场景三：多人底池价值门槛应高于单挑 ---
var soloBar = window.PokerCore.multiwayValueThreshold(.58, 1);
var multiBar = window.PokerCore.multiwayValueThreshold(.58, 4);
assert(multiBar > soloBar, "多人门槛应高于单挑门槛");

// --- 场景四：实际打完若干手牌，验证决策链不抛错且筹码守恒 ---
// 注意：performAction 内部通过 setTimeout 调度下一手，测试里 setTimeout 是空实现，
// 因此循环自己调用 scheduleTurn 推进流程。
shortGame.players.forEach(function (p) { p.chips = 5000; });
var chipsBefore = T.game.players.reduce(function (sum, p) { return sum + p.chips; }, 0);
var handsPlayed = 0;
var modesSeen = {};

for (var hand = 0; hand < 12; hand++) {
  T.startHand();
  var guard = 0;
  while (T.game && !T.game.handOver && guard++ < 300) {
    var actor = T.game.players[T.game.actingIndex];
    if (!actor || T.game.handOver) break;
    var toCall = Math.max(0, T.game.currentBet - actor.bet);

    if (actor.human) {
      T.performAction(actor, toCall ? "call" : "check");
    } else {
      // 同步跑一次与 takeAiTurn 同源的策略路径。
      var equity = window.PokerCore.estimateEquity({
        hole: actor.cards,
        community: T.game.community,
        opponentModels: [{ strengthBias: 0, bluffMix: .18, rangeWidth: 1 }],
        trials: 60
      });
      var plan = T.updateStreetPlan(actor, equity, { bluff: 0, value: 0, aggression: 0, sizing: 0 });
      assert(plan && typeof plan.mode === "string", "街道计划应返回模式");
      modesSeen[plan.mode] = true;
      T.performAction(actor, toCall ? "call" : "check");
    }

    if (T.game.handOver) break;
    // 自己推进：真实环境下这一步由 setTimeout(scheduleTurn) 完成。
    T.scheduleTurn();
  }
  assert(guard < 300, "第 " + (hand + 1) + " 手疑似死循环");
  handsPlayed++;
  if (T.game.handOver) break;
}

assert(handsPlayed > 0, "应至少完成一手牌");
assert(Object.keys(modesSeen).length > 0, "应至少观察到一种街道模式");
var chipsAfter = T.game.players.reduce(function (sum, p) { return sum + p.chips; }, 0);
assert(chipsBefore === chipsAfter,
  "筹码应在牌桌内守恒：" + chipsBefore + " -> " + chipsAfter);

// --- 场景五：锦标赛模式，盲注递增、前注与淘汰 ---
elements.gameMode.value = "tournament";
elements.startingChips.value = "2000";
elements.aiCount.value = "2";
elements.startButton.onclick();

assert(T.game.mode === "tournament", "应进入锦标赛模式");
assert(T.game.smallBlind === 10 && T.game.bigBlind === 20, "锦标赛起始盲注应为 10/20");
assert(T.game.ante === 0, "第一级别不应有前注");

T.game.handsPlayed = 12;
T.startHand();
assert(T.game.smallBlind === 15, "第 12 手后小盲应升到 15，实际 " + T.game.smallBlind);

T.game.handsPlayed = 36;
T.startHand();
assert(T.game.smallBlind === 50, "第 36 手后小盲应升到 50，实际 " + T.game.smallBlind);
assert(T.game.ante === 5, "第 36 手后应开始收 5 点前注，实际 " + T.game.ante);
var contributors = T.game.players.filter(function (p) { return p.totalInvested > 0; });
assert(contributors.length >= 2, "前注与盲注应让多人已有投入");

// 淘汰：筹码归零的 AI 不应在下一手重新买入。
T.game.players.forEach(function (p) { if (!p.human) p.chips = 800; });
var victim = T.game.players[1];
victim.chips = 0;
T.game.handOver = true;
T.startHand();
assert(victim.eliminated === true, "筹码归零的 AI 应被标记淘汰");
assert(victim.chips === 0, "锦标赛中被淘汰的 AI 不应重新买入");

"Simulation tests OK: context, buckets, multiway, tournament levels, antes, elimination, chip conservation";
